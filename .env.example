# Todoist API Configuration
TODOIST_API_TOKEN=your_todoist_api_token_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Configuration (optional - for Claude integration)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Daily Briefing Configuration (optional)
# Output file path (defaults to ~/todoist_briefing.txt)
BRIEFING_OUTPUT_PATH=~/todoist_briefing.txt

# Email settings (optional - leave empty to skip email)
BRIEFING_EMAIL=
BRIEFING_SMTP_HOST=smtp.gmail.com
BRIEFING_SMTP_PORT=587
BRIEFING_SMTP_USER=
BRIEFING_SMTP_PASS=

# Auto-polish settings (optional - automated task improvement)
AUTO_POLISH_ENABLED=false
AUTO_POLISH_QUALITY_THRESHOLD=40
AUTO_POLISH_MAX_TASKS=5
AUTO_POLISH_LOG_PATH=~/todoist_auto_polish.log
